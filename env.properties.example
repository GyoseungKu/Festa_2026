# Copy this file to env.properties and replace every CHANGE_ME value.
# env.properties is ignored by Git. Never commit real credentials.

# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/Likelion_SYU_festa2026?connectionTimeZone=%2B09:00&forceConnectionTimeZoneToSession=true
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# SSO OAuth client
SSO_CLIENT_ID=CHANGE_ME
SSO_CLIENT_SECRET=CHANGE_ME

# Cloudflare R2
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=likelion-main
R2_POLL_PREFIX=festa2026_polls

# Festa HTML welcome email SMTP
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
WELCOME_EMAIL_ENABLED=true
WELCOME_EMAIL_FROM=no-reply@syu-likelion.org
WELCOME_EMAIL_FROM_NAME=Likelion SYU
WELCOME_EMAIL_SITE_URL=https://festa.syu-likelion.org

# Frontend origins: comma-separated, without a trailing slash
FRONTEND_ORIGINS=http://localhost:5173,https://festa.syu-likelion.org

# Local HTTP development only. Keep all values true in HTTPS production.
FESTIVAL_REFRESH_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# Temporary login/signup frontend. Keep false after the production frontend is ready.
SCHOOL_SSO_ENABLED=false
SYU_SSO_CLIENT_ID=festa-2026
SYU_SSO_CLIENT_SECRET=
SYU_SSO_SUBJECT_HASH_SECRET=
SYU_SSO_AUTHORIZE_URL=https://www.syu.ac.kr/festa-sso/authorize
SYU_SSO_TOKEN_URL=https://www.syu.ac.kr/wp-json/syu-festa/v1/token
SYU_SSO_JWKS_URL=https://www.syu.ac.kr/wp-json/syu-sso/v1/jwks
SYU_SSO_CALLBACK_URL=https://festa.syu-likelion.org/auth/sso/callback
SYU_SSO_ISSUER=https://www.syu.ac.kr
SYU_SSO_AUDIENCE=festa-2026
SYU_SSO_RETURN_URL=https://festa.syu-likelion.org/temporary-auth

# Bamboo anonymous chat
BAMBOO_MAX_CONCURRENT_REQUESTS=100
BAMBOO_WRITE_INTERVAL=5s
BAMBOO_WRITES_PER_MINUTE=10
BAMBOO_WRITES_PER_HOUR=200
BAMBOO_REPORTS_PER_MINUTE=10
BAMBOO_MAX_TRACKED_USERS=100000
BAMBOO_IDENTITY_TTL=60s
BAMBOO_IDENTITY_MAX_ENTRIES=20000
BAMBOO_ALERT_ENABLED=true
BAMBOO_ALERT_THRESHOLD=5
BAMBOO_ALERT_TO=CHANGE_ME
BAMBOO_ALERT_FROM=no-reply@syu-likelion.org
BAMBOO_ALERT_ADMIN_URL=https://festa.syu-likelion.org/admin/bamboo
BAMBOO_ALERT_MAX_PER_MINUTE=10
BAMBOO_ALERT_PREVIEW_LENGTH=50

# 일반 공지 (사진·영상 제한은 기존 R2 설정 사용)
NOTICE_STORAGE_PREFIX=festa2026_notices
NOTICE_DOCUMENT_MAX_SIZE=20MB
