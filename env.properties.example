# Copy this file to env.properties and replace every CHANGE_ME value.
# env.properties is ignored by Git. Never commit real credentials.

# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/Likelion_SYU_festa2026?connectionTimeZone=%2B09:00&forceConnectionTimeZoneToSession=true
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# SSO OAuth client
SSO_CLIENT_ID=CHANGE_ME
SSO_CLIENT_SECRET=CHANGE_ME

# Cloudflare R2
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=likelion-main
R2_POLL_PREFIX=festa2026_polls

# Festa HTML welcome email SMTP
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
WELCOME_EMAIL_ENABLED=true
WELCOME_EMAIL_FROM=CHANGE_ME
WELCOME_EMAIL_FROM_NAME=Likelion SYU
WELCOME_EMAIL_SITE_URL=https://festa.syu-likelion.org

# Frontend origins: comma-separated, without a trailing slash
FRONTEND_ORIGINS=http://localhost:5173,https://festa.syu-likelion.org

# Local HTTP development only. Keep both values true in HTTPS production.
FESTIVAL_REFRESH_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false
